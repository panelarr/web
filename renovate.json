{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@tanstack/**"],
      "groupName": "TanStack"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "React"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["vite", "@vitejs/**", "vitest", "vite-plugin-pwa", "workbox-*"],
      "groupName": "Vite and Vitest"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["tailwindcss", "@tailwindcss/**", "tw-animate-css", "tailwind-merge"],
      "groupName": "Tailwind"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ]
}
