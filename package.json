{
  "name": "panelarr-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The Panelarr web app: library, reader and admin",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "fmt": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "gen:api": "node scripts/gen-api.mjs",
    "gen:api:check": "node scripts/gen-api.mjs --check",
    "spec:sync": "node scripts/spec-sync.mjs",
    "spec:check": "node scripts/spec-sync.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@tanstack/react-pacer": "^0.24.1",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-virtual": "^3.14.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.43",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1",
    "yaml": "^2.9.1"
  }
}
